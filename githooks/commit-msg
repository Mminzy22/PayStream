#!/bin/sh
#
# PayStream 프로젝트용 Commit-msg hook
# 커밋 메시지 형식을 검증합니다
# 형식: <이모지> <타입>(선택적 scope): <커밋 메시지>
# 예: ✨ feat(auth): 회원가입 기능 구현
#

# 커밋 메시지 파일 경로 (첫 번째 인자)
commit_msg_file="$1"

# 출력을 stderr로 리다이렉트
exec 1>&2

# 커밋 메시지 읽기 (개행 문자 제거, Windows 경로 및 인코딩 지원)
# UTF-8 인코딩으로 명시적으로 읽기 시도
if [ -f "$commit_msg_file" ]; then
    # 파일이 존재하는 경우
    commit_msg=$(cat "$commit_msg_file" 2>/dev/null | tr -d '\r\n' | sed 's/[[:space:]]*$//')
elif [ -r "$commit_msg_file" ]; then
    # 읽을 수 있는 경우 (Windows 경로일 수 있음)
    commit_msg=$(cat "$commit_msg_file" 2>/dev/null | tr -d '\r\n' | sed 's/[[:space:]]*$//')
else
    # 직접 읽기 시도 (인코딩 변환 포함)
    commit_msg=$(cat "$commit_msg_file" 2>/dev/null | iconv -f UTF-8 -t UTF-8 2>/dev/null | tr -d '\r\n' | sed 's/[[:space:]]*$//' || cat "$commit_msg_file" 2>/dev/null | tr -d '\r\n' | sed 's/[[:space:]]*$//' || echo "")
fi

# 빈 메시지 체크
if [ -z "$commit_msg" ]; then
    echo "😈 커밋 메시지가 비어있습니다."
    exit 1
fi

# 디버깅용 (주석 처리 가능)
# echo "DEBUG: 커밋 메시지 파일: $commit_msg_file" >&2
# echo "DEBUG: 파일 존재 여부: $([ -f "$commit_msg_file" ] && echo "존재" || echo "없음")" >&2
# echo "DEBUG: 커밋 메시지 원본 (첫 50바이트 hex):" >&2
# head -c 50 "$commit_msg_file" 2>/dev/null | od -An -tx1 -v | head -3 >&2 || cat "$commit_msg_file" | head -c 50 | od -An -tx1 | head -3 >&2
# echo "DEBUG: 커밋 메시지 원본 (텍스트):" >&2
# head -3 "$commit_msg_file" >&2
# echo "DEBUG: 커밋 메시지 처리 후 길이: ${#commit_msg}" >&2
# echo "DEBUG: 커밋 메시지 처리 후: [$commit_msg]" >&2
# echo "DEBUG: 정규식 테스트:" >&2
# echo "$commit_msg" | grep -qE ' (feat|fix|refactor|docs|style|test|chore|build)(\([^)]+\))?: .+' && echo "  -> 매칭 성공" >&2 || echo "  -> 매칭 실패" >&2

# 예시 출력 함수
show_examples() {
    echo "올바른 형식: <이모지> <타입>(선택적 scope): <커밋 메시지>"
    echo ""
    echo "예시:"
    echo "  ✨ feat(auth): 회원가입 기능 구현"
    echo "  🐛 fix(login): 로그인 실패 시 예외 처리"
    echo "  ♻️ refactor: 중복된 조건문 제거"
    echo "  📄 docs: 배포 방법 문서 추가"
    echo "  🎨 style: 불필요한 공백 및 줄 정리"
    echo "  🧪 test(user): 사용자 조회 API 테스트 추가"
    echo "  🔧 chore: 라이브러리 버전 업데이트"
    echo "  🏗️ build: settings.gradle에 notification-service 모듈 include 추가"
    echo ""
    echo "이모지와 타입 매핑:"
    echo "  ✨ feat    - 새로운 기능 추가"
    echo "  🐛 fix     - 버그 수정"
    echo "  ♻️ refactor - 코드 리팩토링"
    echo "  📄 docs    - 문서의 수정"
    echo "  🎨 style   - 스타일 변경 (포맷, 세미콜론 등)"
    echo "  🧪 test    - 테스트 코드 작성 또는 수정"
    echo "  🔧 chore   - 환경설정/구성 변경"
    echo "  🏗️ build   - 빌드와 관련된 코드"
}

# 커밋 메시지 형식 검증
# 형식: <이모지> <타입>(선택적 scope): <커밋 메시지>
# Windows 환경의 인코딩 문제를 고려하여 더 유연한 검증
# 이모지 부분을 1-8바이트로 확장 (모든 이모지 변형 지원)
# 먼저 타입이 올바른지 확인
if ! echo "$commit_msg" | grep -qE ' (feat|fix|refactor|docs|style|test|chore|build)(\([^)]+\))?: .+'; then
    echo "😈 커밋 메시지 형식이 올바르지 않습니다."
    echo ""
    show_examples
    exit 1
fi

# 이모지가 있는지 확인 (첫 부분이 공백이 아닌지 확인)
if echo "$commit_msg" | grep -qE '^[[:space:]]'; then
    echo "😈 커밋 메시지는 이모지로 시작해야 합니다."
    echo ""
    show_examples
    exit 1
fi

# 이모지 추출 (첫 부분, 공백 전까지)
emoji=$(echo "$commit_msg" | grep -oE '^[^ ]+')

# 타입 추출 (공백 후 타입 추출)
commit_type=$(echo "$commit_msg" | sed -E 's/^[^ ]+ ([a-z]+)(\([^)]+\))?: .+/\1/')

# 이모지와 타입 매칭 검증 (Windows 인코딩 문제로 인해 이모지 직접 비교는 어려움)
# 대신 타입이 올바른지만 확인하고, 이모지 존재 여부만 확인
# 타입 검증은 이미 위에서 완료되었으므로 여기서는 통과

echo "❤️ 커밋 메시지 형식 검증 통과"
exit 0
